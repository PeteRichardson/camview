<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>REPLACEME</string>

  <!-- Replace mybundle with your preferred bundle string -->
  <key>CFBundleIdentifier</key>
  <string>local.mybundle.REPLACEME</string>

  <key>CFBundleVersion</key>
  <string>1</string>

  <key>CFBundleShortVersionString</key>
  <string>1.0</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleExecutable</key>
  <string>REPLACEME</string>

  <!-- Optional: keeps it from appearing in the Dock / Cmd-Tab -->
  <key>LSUIElement</key>
  <true/>

  <!-- Marks this bundle as generated by Scripts/build-launchers.sh, which is the only
       thing that reads it. The prune step deletes bundles whose name has left VIEWS, and
       without a marker it cannot tell one of its own from a bundle a human put here -- so
       it used to delete a hand-made Automator app, which both READMEs suggest as an
       alternative. Do not add this key by hand to a bundle you want kept. -->
  <key>CamviewGeneratedLauncher</key>
  <true/>
</dict>
</plist>
